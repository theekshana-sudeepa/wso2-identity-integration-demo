# ==============================================================================
# Frontend Public SPA Client Environment Configuration
# Choreo Labs (formerly WSO2) — WSO2 Identity Server 7.0 & Asgardeo
# ==============================================================================

# Active Identity Provider Preset ("wso2is" or "asgardeo")
VITE_IDP_PRESET=wso2is

# --- Option A: Local WSO2 Identity Server 7.0 (Docker) ---
VITE_WSO2_BASE_URL=https://localhost:9443
VITE_CLIENT_ID=your_wso2_spa_client_id
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_BACKEND_API_URL=http://localhost:5050
VITE_SCOPE=openid profile email groups

# --- Option B: Asgardeo Cloud (Choreo Labs SaaS) ---
# VITE_IDP_PRESET=asgardeo
# VITE_WSO2_BASE_URL=https://api.asgardeo.io/t/<your-org-name>
# VITE_CLIENT_ID=your_asgardeo_spa_client_id
# VITE_REDIRECT_URI=http://localhost:5173/callback
# VITE_BACKEND_API_URL=http://localhost:5050
# VITE_SCOPE=openid profile email groups
