# ==============================================================================
# WSO2 Identity Server & Asgardeo Integration Demo - Environment Configuration
# ==============================================================================

# Backend API Configuration
PORT=5050
NODE_ENV=development

# WSO2 Identity Server / Asgardeo IdP Base URL
# For local Docker: https://localhost:9443
# For Asgardeo Cloud: https://api.asgardeo.io/t/<your-tenant-name>
WSO2_IS_BASE_URL=https://localhost:9443

# OAuth 2.0 / OIDC Issuer URL (Must match the 'iss' claim in JWT tokens)
WSO2_ISSUER=https://localhost:9443/oauth2/token

# Expected Audience (Backend Resource Identifier registered in WSO2 IS)
WSO2_AUDIENCE=wso2-api-demo

# JWKS Endpoint (JSON Web Key Set URL for RS256 signature verification)
WSO2_JWKS_URI=https://localhost:9443/oauth2/jwks

# Client Application (SPA) Public Settings
VITE_WSO2_BASE_URL=https://localhost:9443
VITE_CLIENT_ID=dummy_client_id_public_app
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_BACKEND_API_URL=http://localhost:5050
VITE_SCOPE=openid profile email groups
