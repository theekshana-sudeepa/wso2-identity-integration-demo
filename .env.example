# ==============================================================================
# Choreo Labs (formerly WSO2) — WSO2 Identity Server 7.0 & Asgardeo Demo
# Unified Environment Reference (Copy backend/.env.example & frontend/.env.example)
# ==============================================================================

# --- Backend Resource Server (Express + TypeScript) ---
PORT=5050
NODE_ENV=development
# Comma-separated list of allowed SPA origins
CORS_ORIGIN=http://localhost:5173

# --- Option A: WSO2 Identity Server 7.0 (Local Docker) ---
WSO2_IS_BASE_URL=https://localhost:9443
WSO2_ISSUER=https://localhost:9443/oauth2/token
WSO2_AUDIENCE=wso2-api-demo
MCP_AUDIENCE=http://localhost:5050/api/mcp
WSO2_JWKS_URI=https://localhost:9443/oauth2/jwks
# Set true ONLY for local self-signed Docker WSO2 IS certificates in development
ALLOW_SELF_SIGNED_CERTS=false

# --- Option B: Asgardeo Cloud (Choreo Labs SaaS) ---
# WSO2_IS_BASE_URL=https://api.asgardeo.io/t/<your-org-name>
# WSO2_ISSUER=https://api.asgardeo.io/t/<your-org-name>/oauth2/token
# WSO2_AUDIENCE=<your-asgardeo-app-client-id-or-api-resource>
# WSO2_JWKS_URI=https://api.asgardeo.io/t/<your-org-name>/oauth2/jwks
# ALLOW_SELF_SIGNED_CERTS=false

# --- JWKS Cache & Rate Limit Tuning (Optional) ---
JWKS_CACHE_MAX_AGE_MS=600000
JWKS_RATE_LIMIT_RPM=10

# --- Frontend Public SPA Client (React + Vite) ---
# Local WSO2 IS 7.0: https://localhost:9443
# Asgardeo Cloud:    https://api.asgardeo.io/t/<your-org-name>
VITE_WSO2_BASE_URL=https://localhost:9443
VITE_CLIENT_ID=your_public_spa_client_id
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_BACKEND_API_URL=http://localhost:5050
VITE_MCP_AUDIENCE=http://localhost:5050/api/mcp
VITE_SCOPE=openid profile email groups
VITE_IDP_PRESET=wso2is
