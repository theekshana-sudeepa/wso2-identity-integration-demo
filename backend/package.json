{
  "name": "wso2-identity-demo-backend",
  "version": "2.0.0",
  "description": "Stateless Express + strict TypeScript Resource Server validating Choreo Labs (formerly WSO2) Identity Server 7.0 & Asgardeo RS256 JWTs via JWKS and enforcing RBAC scopes.",
  "main": "dist/server.js",
  "author": "Theekshana Sudeepa",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run src",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jose": "^4.15.9",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "globals": "^17.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^5.1.1"
  }
}
